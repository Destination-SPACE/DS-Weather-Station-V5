/*
 * Device tree overlay for BME280 sensor on ESP32-S3 Feather TFT Reverse
 * File should be named: adafruit_feather_esp32s3_tft_reverse_esp32s3_procpu.overlay
 */

/ {
    aliases {
        bme280 = &bme280;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    
    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
        status = "okay";
    };
};